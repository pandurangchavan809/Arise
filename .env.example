# Local Adaptive Memory Runtime settings.
# Copy to .env for a fresh checkout. Provider keys may stay blank for local memory use.

# Local SQLite database. Keep the backend working directory at the project root.
DATABASE_URL=sqlite:///./adaptive_memory.db
LOG_LEVEL=INFO

# Optional Nebius LLM integration. Leave the key blank to disable it.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Optional Tavily web search integration.
TAVILY_API_KEY=

# Optional Deepgram speech-to-text and text-to-speech integration.
DEEPGRAM_API_KEY=

# Memory recall and storage budgets.
MAX_MEMORIES=10
MAX_CONTEXT_TOKENS=2000
MAX_LATENCY_MS=100
MAX_STORAGE_BYTES=104857600

# Embeddings are optional and disabled by default.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=nebius
EMBEDDING_MODEL=text-embedding-3-small
